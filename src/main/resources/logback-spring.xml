<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <conversionRule conversionWord="maskPii" converterClass="com.yojnasetu.common.logging.PiiMaskingConverter" />

    <!-- Standard Console Appender with PII Masking -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-N/A}] - %maskPii(%msg)%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Application Logging Level -->
    <logger name="com.yojnasetu" level="INFO" />

    <!-- Framework Logging Levels -->
    <logger name="org.springframework.web" level="WARN" />
    <logger name="org.springframework.security" level="INFO" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="org.flywaydb" level="INFO" />
    <logger name="com.zaxxer.hikari" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
