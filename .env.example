# ==============================================================================
# YOJNA SETU V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or set variables in your cloud deployment environment.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment (local, staging, prod)
APP_ENV=local
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Supabase PostgreSQL (Project #2)
# Dedicated Schema: yojna_setu
# ------------------------------------------------------------------------------
DATABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=YOUR_STRONG_SUPABASE_PASSWORD
DATABASE_SSL_MODE=require
DATABASE_SCHEMA=yojna_setu

# Full JDBC URL (Alternatively assemble via host/port/db)
DATABASE_URL=jdbc:postgresql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?sslmode=${DATABASE_SSL_MODE}&currentSchema=${DATABASE_SCHEMA}

# ------------------------------------------------------------------------------
# AI Engine (Groq Cloud API)
# Models: llama-3.3-70b-versatile / llama-3.1-8b-instant, whisper-large-v3-turbo
# ------------------------------------------------------------------------------
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# WhatsApp Provider (Twilio)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/twilio/whatsapp

# ------------------------------------------------------------------------------
# Internal Security & API Protection
# ------------------------------------------------------------------------------
# 256-bit secret for internal / administrative API endpoints (X-API-KEY header)
INTERNAL_API_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY

# Phone Number Blind Index Pepper (used with SHA-256 for blinded lookups)
PHONE_HASH_PEPPER=GENERATE_RANDOM_PEPPER_FOR_PHONE_HASHING

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_BURST_CAPACITY=30
